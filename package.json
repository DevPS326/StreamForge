{
  "name": "streamforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.29.0",
  "engines": {
    "node": ">=22.13 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "node scripts/prepare-prisma.mjs && node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "node scripts/prepare-prisma.mjs && turbo build",
    "typecheck": "node scripts/prepare-prisma.mjs && turbo typecheck",
    "lint": "eslint . && pnpm --filter @streamforge/web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/prepare-prisma.mjs && turbo test",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration/streamforge.test.mjs",
    "test:e2e": "node --env-file-if-exists=.env scripts/run.mjs pnpm exec playwright test",
    "db:generate": "pnpm --filter @streamforge/db generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/run.mjs pnpm --filter @streamforge/db migrate",
    "db:seed": "node --env-file-if-exists=.env scripts/run.mjs pnpm --filter @streamforge/db seed",
    "sample": "node scripts/sample.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "@streamforge/db": "workspace:*",
    "@aws-sdk/client-s3": "^3.915.0",
    "@aws-sdk/client-sqs": "^3.915.0",
    "@aws-sdk/s3-request-presigner": "^3.915.0"
  }
}
